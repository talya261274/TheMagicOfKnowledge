        + {static} signOutUser(context): void
        + {static} isUserLoggedIn(context): boolean
        + {static} getUserId(context): String
        + {static} saveCurrentChild(context, child): void
        + {static} getCurrentChild(context): UserChild
        + {static} isChildSelected(context): boolean
        + {static} clearSelectedChild(context): void
        + {static} saveCurrentChildId(context, childId): void
        + {static} getCurrentChildId(context): String
        + {static} clear(context): void
