    }

    class KeyboardAdapter {
        - letters: String[]
        - listener: OnKeyClickListener
        --
        + getView(position, view, parent): View
    }

    class SubjectProgressAdapter {
        - statsList: List<SubjectStat>
        --
        + onBindViewHolder(holder, position): void
    }

    class LevelProgressAdapter {
        - levels: List<LevelProgress>
        --
        + onBindViewHolder(holder, position): void
    }

    class UserAdapter {
        - userList: List<UserParent>
        - onUserClickListener: OnUserClickListener
        --
        + setUserList(users): void
        + addUser(user): void
        + updateUser(user): void
        + removeUser(user): void
    }
}

