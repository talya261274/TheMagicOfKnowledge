' ==================== Models ====================
package "Models" #FFF3E0 {

    class UserParent {
        + id: String
        + firstName: String
        + lastName: String
        + email: String
        + phone: String
        + birthDate: String
        + userName: String
        + password: String
        + isAdmin: boolean
        - avatar: String
        - childrenList: Map<String, UserChild>
        --
        + getChildrenListAsList(): List<UserChild>
        + toString(): String
    }

    class UserChild {
        - id: String
        - parentId: String
        - name: String
        - avatar: String
        - ageGroup: String
        - age: int
        - currentLevel: String
        - totalTimeSeconds: long
        - progress: Map<String, Object>
        - completedSubjects: Map<String, Boolean>
        - lastPlacementScore: Double
        - startingLevel: String
        --
        + initializeDefaultProgress(): void
        + getFormattedTime(): String
        + toMap(): Map<String, Object>
    }

    class Question {
        - questionText: String
        - options: List<String>
        - optionLabels: List<String>
        - correctAnswerIndex: int
        - mediaUrl: String
    }

    class Pair {
        - left: String
        - right: String
        - id: String
    }

    class SentenceQuestion {
        - sentence: String
        - correctAnswer: String
        - hintImage: String
    }

    class MemoryCard {
        + imageRes: int
        + text: String
        + matchId: String
        + isFlipped: boolean
        + isMatched: boolean
    }

    class FlashCard {
        - imageResId: int
        - answer: String
    }

    class UnifiedQuestion {
        - type: Type
        - data: Object
        --
        + getType(): Type
        + getData(): Object
    }

    enum Type {
        AUDIO
        IMAGE
        MATCHING
        SENTENCE
        MEMORY
    }

    class SubjectStat {
        - subjectName: String
        - attempts: int
        - timeInSeconds: long
        - completed: boolean
        - progressPercent: int
    }

    class LevelProgress {
        - ageGroup: String
        - subjects: List<SubjectStat>
        - isCurrent: boolean
        - isLocked: boolean
        - isCompleted: boolean
        - isExpanded: boolean
        --
        + getTotalTimeSeconds(): long
        + getTotalAttempts(): int
        + getAveragePercent(): int
        + getCompletedCount(): int
    }

    class GameProgress {
        - attempts: int
        - completed: boolean
        - timeSeconds: long
    }

    enum Role {
        CHILD
        PARENT
        ADMIN
    }

    class UserRole {
        + {static} getCurrentRole(context): Role
        + {static} isAdmin(context): boolean
        + {static} isChild(context): boolean
        + {static} isParent(context): boolean
    }
}

' ==================== Services ====================
package "Services" #E8F5E9 {
    class DatabaseService {
        - {static} instance: DatabaseService
        - databaseReference: DatabaseReference
        --
        + {static} getInstance(): DatabaseService
        + generateUserId(): String
        + generateChildId(userId): String
        + createNewUser(user, callback): void
        + getUser(uid, callback): void
        + getUserList(callback): void
        + getUserByUsernameAndPassword(username, password, callback): void
        + getUserByEmail(email, callback): void
        + checkIfEmailExists(email, callback): void
        + updateUser(userId, function, callback): void
        + deleteUser(uid, callback): void
        + deleteChild(parentId, childId, callback): void
        + updateDetailedProgress(...): void
        + resetGameIndex(...): void
    }

    interface "DatabaseCallback<T>" as DBCallback {
        + onCompleted(T object): void
        + onFailed(Exception e): void
    }
}

