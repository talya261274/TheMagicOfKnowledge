    class ImageUtil {
        + {static} requestPermission(activity): void
        + {static} convertTo64Base(postImage): String
        + {static} convertFrom64base(base64Code): Bitmap
        + {static} convertBitmapTo64Base(bitmap): String
        + {static} loadAvatar(context, imageView, avatar): void
    }

    class GameProgressManager {
        + {static} saveProgress(...): void
