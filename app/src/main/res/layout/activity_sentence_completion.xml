<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:padding="12dp">

    <ProgressBar
        android:id="@+id/globalProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:max="3"
        android:progress="1"
        android:progressTint="#4CAF50"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivMixedAvatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/globalProgress"
        app:srcCompat="@drawable/wizard_placeholder" />

    <TextView
        android:id="@+id/tvMixedQuestionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/gan"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivMixedAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivMixedAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivMixedAvatar" />

    <LinearLayout
        android:id="@+id/containerSelection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivMixedAvatar">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMixedPlayAudio"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                app:backgroundTint="#FF9800"
                app:cornerRadius="70dp"
                app:icon="@drawable/ic_volume_up"
                app:iconSize="80dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMixedMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="20dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp">

                <ImageView
                    android:id="@+id/ivMixedImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="centerInside" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAns1"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:textColor="#333333"
                android:textSize="18sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:iconGravity="top"
                app:iconSize="80dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAns2"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:textColor="#333333"
                android:textSize="18sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:iconGravity="top"
                app:iconSize="80dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAns3"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:textColor="#333333"
                android:textSize="18sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:iconGravity="top"
                app:iconSize="80dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAns4"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:textColor="#333333"
                android:textSize="18sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:iconGravity="top"
                app:iconSize="80dp" />
        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerMatching"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivMixedAvatar">

        <LinearLayout
            android:id="@+id/mixedLeftColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="20dp"
            android:alpha="0.3"
            android:background="@color/white" />

        <LinearLayout
            android:id="@+id/mixedRightColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSentence"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivMixedAvatar">

        <ImageView
            android:id="@+id/ivMixedSentenceHint"
            android:layout_width="200dp"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvMixedSentenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="25sp" />

        <EditText
            android:id="@+id/etMixedAnswer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/keyboard_key_selector"
            android:focusable="false"
            android:gravity="center"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="32dp"
            android:backgroundTint="#FF9800"
            android:text="בדוק תשובה"
            android:textStyle="bold" />

        <GridView
            android:id="@+id/mixedKeyboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:horizontalSpacing="8dp"
            android:numColumns="7"
            android:padding="8dp"
            android:verticalSpacing="8dp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/containerMemory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivMixedAvatar">

        <GridView
            android:id="@+id/gvMemoryBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:horizontalSpacing="12dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>