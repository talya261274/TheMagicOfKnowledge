<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- אווטר עגול -->
    <androidx.cardview.widget.CardView
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:cardBackgroundColor="#F8E4E4"
        app:cardCornerRadius="35dp"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/iv_child_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_1"
            android:contentDescription="אווטר ילד" />

    </androidx.cardview.widget.CardView>

    <!-- שם הילד -->
    <TextView
        android:id="@+id/tv_child_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/gan"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="שם הילד"
        android:textColor="#1E5F8B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- גיל -->
    <TextView
        android:id="@+id/tv_child_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/varelaround"
        android:text="גיל 5"
        android:textColor="#5C6166"
        android:textSize="12sp" />

</LinearLayout>