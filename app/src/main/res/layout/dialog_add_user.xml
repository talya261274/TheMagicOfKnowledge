<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== כותרת עם אימוג'י ===== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="✨"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gan"
                android:text="הוספת משתמש"
                android:textColor="#1E5F8B"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ===== כותרת משנה ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/varelaround"
            android:text="מלאו את הפרטים ליצירת משתמש חדש"
            android:textColor="#5C6166"
            android:textSize="13sp" />

        <!-- ===== שם פרטי + שם משפחה ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="שם פרטי"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#1E5F8B"
                app:hintTextColor="#1E5F8B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_dialog_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/varelaround"
                    android:inputType="textPersonName"
                    android:textColor="#2C3E50"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="שם משפחה"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#1E5F8B"
                app:hintTextColor="#1E5F8B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_dialog_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/varelaround"
                    android:inputType="textPersonName"
                    android:textColor="#2C3E50"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ===== אימייל ===== -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="אימייל"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1E5F8B"
            app:hintTextColor="#1E5F8B"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#1E5F8B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:inputType="textEmailAddress"
                android:textColor="#2C3E50"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== טלפון ===== -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="מספר טלפון"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1E5F8B"
            app:hintTextColor="#1E5F8B"
            app:startIconDrawable="@android:drawable/sym_action_call"
            app:startIconTint="#1E5F8B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:inputType="phone"
                android:textColor="#2C3E50"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== תאריך לידה ===== -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="תאריך לידה"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1E5F8B"
            app:hintTextColor="#1E5F8B"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="#1E5F8B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_birth_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="@font/varelaround"
                android:textColor="#2C3E50"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== שם משתמש ===== -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="שם משתמש"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1E5F8B"
            app:hintTextColor="#1E5F8B"
            app:startIconDrawable="@android:drawable/ic_menu_myplaces"
            app:startIconTint="#1E5F8B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:textColor="#2C3E50"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== סיסמה ===== -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="סיסמה"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1E5F8B"
            app:endIconMode="password_toggle"
            app:endIconTint="#1E5F8B"
            app:hintTextColor="#1E5F8B"
            app:startIconDrawable="@drawable/ic_password"
            app:startIconTint="#1E5F8B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:inputType="textPassword"
                android:textColor="#2C3E50"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== אימות סיסמה ===== -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="אימות סיסמה"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#1E5F8B"
            app:endIconMode="password_toggle"
            app:endIconTint="#1E5F8B"
            app:hintTextColor="#1E5F8B"
            app:startIconDrawable="@drawable/ic_password"
            app:startIconTint="#1E5F8B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_dialog_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:inputType="textPassword"
                android:textColor="#2C3E50"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== הרשאת מנהל ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layoutDirection="rtl"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="👑"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gan"
                        android:text="הרשאת מנהל"
                        android:textColor="#1E5F8B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/varelaround"
                        android:text="גישה מלאה לכל המערכת"
                        android:textColor="#5C6166"
                        android:textSize="11sp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dialog_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== כפתורים ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- כפתור ביטול -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/gan"
                android:text="ביטול"
                android:textColor="#5C6166"
                android:textSize="15sp"
                app:cornerRadius="24dp"
                app:strokeColor="#9E9E9E" />

            <!-- כפתור שמירה -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/gan"
                android:text="צור משתמש"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="#FF9800"
                app:cornerRadius="24dp"
                app:elevation="4dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>