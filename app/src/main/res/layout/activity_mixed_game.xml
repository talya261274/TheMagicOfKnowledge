<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:padding="16dp">

        <!-- ===== פס התקדמות ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/progressCard"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toStartOf="@id/exitCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gan"
                    android:text="0%"
                    android:textColor="#FF9800"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/globalProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/progress_bar_colorful" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="20sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== כפתור יציאה ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/exitCard"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="25dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#E91E63" />

        </androidx.cardview.widget.CardView>

        <!-- ===== כותרת השאלה ===== -->
        <TextView
            android:id="@+id/tvMixedQuestionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/gan"
            android:gravity="center"
            android:shadowColor="#65A2B8"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:text="האזינו לשאלה 🎧"
            android:textColor="#1E5F8B"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressCard" />

        <!-- ===== אזור תוכן ===== -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMixedQuestionTitle">

            <!-- ===== מצב 1: בחירה (אודיו/תמונה) ===== -->
            <LinearLayout
                android:id="@+id/containerSelection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- כפתור אודיו -->
                <LinearLayout
                    android:id="@+id/btnMixedPlayAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#dafaff"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="20dp"
                            android:paddingBottom="20dp">

                            <FrameLayout
                                android:layout_width="120dp"
                                android:layout_height="120dp">

                                <View
                                    android:layout_width="120dp"
                                    android:layout_height="120dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.15"
                                    android:background="@drawable/circle_glow" />

                                <View
                                    android:layout_width="90dp"
                                    android:layout_height="90dp"
                                    android:layout_gravity="center"
                                    android:alpha="0.2"
                                    android:background="@drawable/circle_glow" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPlayAudio"
                                    android:layout_width="120dp"
                                    android:layout_height="120dp"
                                    android:layout_gravity="center"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    app:backgroundTint="#FFFFFF"
                                    app:cornerRadius="60dp"
                                    app:elevation="12dp"
                                    app:icon="@drawable/ic_volume_up"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="70dp"
                                    app:iconTint="#FF9800"
                                    app:rippleColor="#FFE0B2" />

                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:alpha="0.8"
                                android:fontFamily="@font/gan"
                                android:text="לחצו להאזנה 🎧"
                                android:textColor="#1E5F8B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- תמונה (מצב IMAGE) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/imageCardContainer"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginBottom="30dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp">

                    <ImageView
                        android:id="@+id/ivMixedImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="תמונת שאלה"
                        android:padding="16dp"
                        android:scaleType="fitCenter" />

                </androidx.cardview.widget.CardView>

                <!-- 4 כפתורי תשובה -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAns1"
                            android:layout_width="0dp"
                            android:layout_height="130dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#FF9800"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="8dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/btnAns1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:scaleType="centerInside" />

                                <TextView
                                    android:id="@+id/tvAns1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/gan"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAns2"
                            android:layout_width="0dp"
                            android:layout_height="130dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#4CAF50"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="8dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/btnAns2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:scaleType="centerInside" />

                                <TextView
                                    android:id="@+id/tvAns2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/gan"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAns3"
                            android:layout_width="0dp"
                            android:layout_height="130dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#2196F3"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="8dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/btnAns3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:scaleType="centerInside" />

                                <TextView
                                    android:id="@+id/tvAns3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/gan"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAns4"
                            android:layout_width="0dp"
                            android:layout_height="130dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#E91E63"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="8dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/btnAns4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="14dp"
                                    android:scaleType="centerInside" />

                                <TextView
                                    android:id="@+id/tvAns4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/gan"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ===== מצב 2: התאמת זוגות ===== -->
            <LinearLayout
                android:id="@+id/containerMatching"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="top"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <!-- שתי עמודות -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/mixedLeftColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="#dafaff" />

                    <LinearLayout
                        android:id="@+id/mixedRightColumn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ===== מצב 3: השלמת משפט ===== -->
            <LinearLayout
                android:id="@+id/containerSentence"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="#dafaff"
                            app:cardCornerRadius="60dp"
                            app:cardElevation="6dp">

                            <ImageView
                                android:id="@+id/ivMixedSentenceHint"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="רמז"
                                android:padding="14dp"
                                android:scaleType="centerInside" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/tvMixedSentenceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/gan"
                            android:gravity="center"
                            android:textColor="#1E5F8B"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:strokeColor="#FF9800"
                    app:strokeWidth="2dp">

                    <EditText
                        android:id="@+id/etMixedAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@android:color/transparent"
                        android:focusable="false"
                        android:fontFamily="@font/gan"
                        android:gravity="center"
                        android:hint="הקלידו כאן..."
                        android:textColor="#1E5F8B"
                        android:textColorHint="#9E9E9E"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <!-- מקלדת -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <GridView
                        android:id="@+id/mixedKeyboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginLeft="5dp"
                        android:horizontalSpacing="5dp"
                        android:numColumns="7"
                        android:padding="8dp"
                        android:verticalSpacing="5dp" />

                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheck"
                    android:layout_width="300dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center"
                    android:fontFamily="@font/gan"
                    android:text="בדקו תשובה ✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="#4CAF50"
                    app:cornerRadius="27dp"
                    app:elevation="8dp" />

            </LinearLayout>

            <!-- ===== מצב 4: משחק זיכרון ===== -->
            <LinearLayout
                android:id="@+id/containerMemory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                android:visibility="gone">

                <GridView
                    android:id="@+id/gvMemoryBoard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:horizontalSpacing="12dp"
                    android:numColumns="3"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

            </LinearLayout>

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>