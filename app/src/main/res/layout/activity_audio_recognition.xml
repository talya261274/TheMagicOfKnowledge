<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:padding="12dp">

    <ProgressBar
        android:id="@+id/testProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:max="3"
        android:progress="1"
        android:progressTint="#4CAF50" />

    <ImageView
        android:id="@+id/ivGameAvatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/testProgress"
        app:srcCompat="@drawable/wizard_placeholder" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/gan"
        android:gravity="center"
        android:text="הקשיבו לשאלה:"
        android:textColor="@color/white"
        android:textSize="35sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivGameAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivGameAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivGameAvatar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayAudio"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="60dp"
        app:backgroundTint="#FF9800"
        app:cornerRadius="70dp"
        app:elevation="8dp"
        app:icon="@drawable/ic_speaker"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestion" />

    <GridLayout
        android:id="@+id/answersGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        app:layout_constraintTop_toBottomOf="@+id/btnPlayAudio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns1"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:minHeight="130dp"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="20dp"
            app:iconGravity="top"
            app:iconSize="90dp"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns2"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:minHeight="130dp"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="20dp"
            app:iconGravity="top"
            app:iconSize="90dp"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns3"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:minHeight="130dp"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="20dp"
            app:iconGravity="top"
            app:iconSize="90dp"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAns4"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:minHeight="130dp"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="20dp"
            app:iconGravity="top"
            app:iconSize="90dp"
            android:padding="8dp" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>