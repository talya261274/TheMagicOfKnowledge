<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/main_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- כותרת עליונה -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:fontFamily="@font/gan"
        android:gravity="center"
        android:shadowColor="@android:color/holo_blue_light"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:text="מי אני?"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:textStyle="bold" />

    <!-- כרטיס -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="280dp"
        android:layout_height="360dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp"
            android:background="#80FFFFFF">

            <!-- תמונה -->
            <ImageView
                android:id="@+id/imgCard"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:visibility="visible"/>

            <!-- טקסט -->
            <TextView
                android:id="@+id/tvCardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:visibility="gone"/>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- כפתורי ניווט -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/btn_movesides"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="70dp"
            android:layout_height="10dp"/>

        <ImageButton
            android:id="@+id/btnNext"
            android:src="@drawable/ic_arrow_forward"            android:background="@drawable/btn_movesides"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPlaySound"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_orange_selector"
        android:src="@drawable/ic_volume_up"
        android:scaleType="centerInside"
        android:visibility="visible"
        android:contentDescription="Play Sound"/>

</LinearLayout>
