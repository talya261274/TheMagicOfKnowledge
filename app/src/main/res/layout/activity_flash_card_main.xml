<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- כותרת עליונה -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:fontFamily="@font/gan"
        android:gravity="center"
        android:shadowColor="@android:color/holo_blue_light"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:text="מי אני?"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:textStyle="bold" />

    <!-- כרטיס -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="280dp"
        android:layout_height="360dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80FFFFFF"
            android:padding="24dp">

            <!-- תמונה -->
            <ImageView
                android:id="@+id/imgCard"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:visibility="visible" />

            <!-- טקסט -->
            <TextView
                android:id="@+id/tvCardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="40sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- כפתורי ניווט -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/btn_movesides"
            android:shadowColor="@android:color/holo_blue_light"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="70dp"
            android:layout_height="10dp" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/btn_movesides"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPlaySound"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_orange_selector"
        android:contentDescription="Play Sound"
        android:scaleType="centerInside"
        android:src="@drawable/ic_volume_up"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartGame"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#03A9F4"
        android:fontFamily="@font/gan"
        android:text="בואו נשחק! 🎮"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="30dp" />

</LinearLayout>
