<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- עיגול עם אמוג'י -->
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="50dp"
            app:cardElevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🎮"
                android:textSize="48sp" />

        </androidx.cardview.widget.CardView>

        <!-- כותרת -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="✨"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gan"
                android:gravity="center"
                android:shadowColor="#FFD54F"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="ברוך השב!"
                android:textColor="#FF9800"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✨"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- כרטיס הודעה -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#dafaff"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="מה תרצה לעשות עכשיו?"
                android:textColor="#1E5F8B"
                android:textSize="15sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

        <!-- כפתור התחל משחק -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/gan"
            android:text="בוא נשחק! 🎮"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="27dp"
            app:elevation="6dp" />

        <!-- כפתור כרטיסיות -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowCards"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/varelaround"
            android:text="חזרה על הכרטיסיות 📖"
            android:textColor="#1E5F8B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:strokeColor="#1E5F8B"
            app:strokeWidth="1.5dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>