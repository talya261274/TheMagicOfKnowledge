<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- עיגול עם מנעול -->
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardCornerRadius="50dp"
            app:cardElevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔒"
                android:textSize="48sp" />

        </androidx.cardview.widget.CardView>

        <!-- כותרת -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="✨"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gan"
                android:gravity="center"
                android:shadowColor="#FFD54F"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="אימות הורה"
                android:textColor="#FF9800"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✨"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- כרטיס הודעה -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#dafaff"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varelaround"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="רק הורים יכולים לחזור למסך ניהול\nאנא הכנס את הסיסמה שלך 🔑"
                android:textColor="#1E5F8B"
                android:textSize="13sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

        <!-- שדה סיסמה -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#FF9800"
            app:strokeWidth="2dp">

            <android.widget.EditText
                android:id="@+id/etParentPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/varelaround"
                android:gravity="center"
                android:hint="הכנס סיסמה"
                android:inputType="textPassword"
                android:textColor="#1E5F8B"
                android:textColorHint="#9E9E9E"
                android:textSize="18sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- שגיאה -->
        <TextView
            android:id="@+id/tvPasswordError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/varelaround"
            android:text="סיסמה שגויה ❌"
            android:textColor="#F44336"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- כפתור אישור -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/gan"
            android:text="כניסה להורה 🔓"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="27dp"
            app:elevation="6dp" />

        <!-- ביטול -->
        <TextView
            android:id="@+id/btnCancelPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/varelaround"
            android:padding="10dp"
            android:text="ביטול"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>