<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_matching_game"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".screens.MatchingGameActivity">

    <!-- כותרת המשחק -->
    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="משחק התאמה"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/gan"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"/>

    <!-- GridView של הכרטיסים -->
    <GridView
        android:id="@+id/gridViewCards"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="auto_fit"
        android:columnWidth="100dp"
        android:verticalSpacing="16dp"
        android:horizontalSpacing="16dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:layout_below="@id/tvGameTitle"
        android:layout_marginTop="100dp"
        android:layout_margin="16dp"/>

</RelativeLayout>
