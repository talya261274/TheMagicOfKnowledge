<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- עיגול עם אימוג'י -->
        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="70dp"
            app:cardElevation="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔮"
                android:textSize="70sp" />

        </androidx.cardview.widget.CardView>

        <!-- כותרת עם כוכבים -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="✨"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gan"
                android:gravity="center"
                android:shadowColor="#90CAF9"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="ברוכים הבאים"
                android:textColor="#1E5F8B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="✨"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- כותרת משנה -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/gan"
            android:gravity="center"
            android:text="לפני שמתחילים את ההרפתקה..."
            android:textColor="#5C6166"
            android:textSize="18sp" />

        <!-- כרטיס הסבר -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#dafaff"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gan"
                    android:gravity="center"
                    android:text="🎯 מבדק רמה קצר 🎯"
                    android:textColor="#1E5F8B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/varelaround"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="כדי שנוכל להתאים לך את הקסמים המושלמים, בואו נבדוק יחד לאיזו רמה אתה שייך! 🪄"
                    android:textColor="#1E5F8B"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- כפתור התחלה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTest"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/gan"
            android:text="בואו נתחיל! 🚀"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="27dp"
            app:elevation="6dp" />

        <!-- כפתור אחר כך -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/varelaround"
            android:text="אחר כך... ⏰"
            android:textColor="#1E5F8B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:strokeColor="#1E5F8B"
            app:strokeWidth="1.5dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>