<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/main_background"
    tools:context=".screens.AvatarSelectionActivity">

    <TextView
        android:id="@+id/tvSelectAvatarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחירת לוגו"
        android:textSize="45dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:elevation="5dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/gan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSelectAvatarSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/gveretlevin"
        android:text="לחץ על התמונה שאתה הכי אוהב"
        android:textColor="#546E7A"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSelectAvatarTitle" />

    <GridView
        android:id="@+id/gvAvatars"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:numColumns="3"
        android:horizontalSpacing="12dp"
        android:verticalSpacing="12dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSelectAvatarSubTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>