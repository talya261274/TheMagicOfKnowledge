<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- כותרת -->
        <TextView
            android:id="@+id/tvSelectAvatarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:elevation="5dp"
            android:fontFamily="@font/gan"
            android:text="בחירת לוגו"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSelectAvatarSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/varelaround"
            android:text="לחצו על התמונה שאתם הכי אוהבים ✨"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSelectAvatarTitle" />

        <!-- תצוגה מקדימה -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreview"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="40dp"
            android:visibility="gone"
            app:cardCornerRadius="60dp"
            app:cardElevation="8dp"
            app:strokeColor="#E91E63"
            app:strokeWidth="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSelectAvatarSubTitle">>

            <ImageView
                android:id="@+id/ivSelectedPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <!-- כרטיס לבן עם תצוגה מקדימה וכפתור -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGallerySection"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="#F6EBF3"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardPreview">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFromGallery"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:fontFamily="@font/varelaround"
                    android:layout_gravity="center"
                    android:text="העלה תמונה 📷"
                    android:textColor="#E91E63"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"/>

        </androidx.cardview.widget.CardView>

        <!-- GridView אווטרים -->
        <GridView
            android:id="@+id/gvAvatars"
            android:layout_width="0dp"
            android:layout_height="350dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:horizontalSpacing="12dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="12dp"
            app:layout_constraintBottom_toTopOf="@+id/btnConfirmAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardGallerySection" />

        <!-- כפתור אישור -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAvatar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:fontFamily="@font/varelaround"
            android:text="אישור ✓"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="28dp"
            app:elevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gvAvatars" />

        <!-- כפתור חזרה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackAvatar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/varelaround"
            android:text="חזור"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnConfirmAvatar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>