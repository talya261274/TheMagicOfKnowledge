<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="230dp"
    android:background="@drawable/main_background"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="20dp"
    android:layout_marginBottom="10dp"
    android:layoutDirection="rtl"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- שורה עליונה: אווטר + שם -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- אווטר עגול עם מסגרת -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:id="@+id/nav_user_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />

        </com.google.android.material.card.MaterialCardView>

        <!-- שם -->
        <TextView
            android:id="@+id/nav_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/gan"
            android:text="שלום, משתמש"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- כותרת -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/varelaround"
            android:text="הקסם שבידע ✨"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- קו הפרדה -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#2E7BAF" />

</LinearLayout>