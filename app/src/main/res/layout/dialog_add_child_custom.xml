<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E4CBDF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוספת קוסם חדש"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="@font/gan" />

        <EditText
            android:id="@+id/etDialogChildName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/keyboard_key_selector"
            android:hint="שם הילד"
            android:paddingHorizontal="15dp"
            android:textColor="#999595"
            android:textColorHint="#CCCCCC" />

        <EditText
            android:id="@+id/etDialogChildAge"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/keyboard_key_selector"
            android:hint="גיל (3-8)"
            android:inputType="number"
            android:paddingHorizontal="15dp"
            android:textColor="#999595"
            android:textColorHint="#CCCCCC" />

        <TextView
            android:id="@+id/tvDialogError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogAdd"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:text="הוסף קוסם"
            android:textSize="18sp"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="28dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>