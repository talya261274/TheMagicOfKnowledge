<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".SelectSubjectActivity">


    <TextView
        android:id="@+id/tvSelectSubjectTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gan"
        android:shadowColor="#65A2B8"
        android:shadowDx="10"
        android:shadowDy="10"
        android:shadowRadius="20"
        android:text="בחר נושא"
        android:textColor="@color/black"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="121dp" />

    <Button
        android:id="@+id/btnAnimals"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="חיות"
        android:textColor="@color/black"
        app:cornerRadius="20dp"
        android:backgroundTint="#29A6F0"
        android:textSize="20dp"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="12dp"
        tools:layout_editor_absoluteX="68dp"
        tools:layout_editor_absoluteY="238dp" />

    <Button
        android:id="@+id/btnColors"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="צבעים"
        android:textColor="@color/black"
        app:cornerRadius="20dp"
        android:backgroundTint="#4CA621"
        android:textSize="20dp"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="12dp"
        tools:layout_editor_absoluteX="214dp"
        tools:layout_editor_absoluteY="238dp" />

    <Button
        android:id="@+id/btnNumbers"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="מספרים"
        android:textColor="@color/black"
        app:cornerRadius="20dp"
        android:backgroundTint="#E097A4"
        android:textSize="20dp"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="12dp"
        tools:layout_editor_absoluteX="68dp"
        tools:layout_editor_absoluteY="370dp" />

    <Button
        android:id="@+id/btnLetters"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="אותיות"
        android:textColor="@color/black"
        app:cornerRadius="20dp"
        android:backgroundTint="#F4D248"
        android:textSize="20dp"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="12dp"
        tools:layout_editor_absoluteX="214dp"
        tools:layout_editor_absoluteY="370dp" />

    <Button
        android:id="@+id/btnShapes"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="צורות"
        android:textColor="@color/black"
        android:backgroundTint="#FF914D"
        android:textSize="20dp"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="12dp"
        app:cornerRadius="20dp"
        tools:layout_editor_absoluteX="68dp"
        tools:layout_editor_absoluteY="502dp" />

    <Button
        android:id="@+id/btnBodyParts"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="חלקי גוף"
        android:textColor="@color/black"
        app:cornerRadius="20dp"
        android:backgroundTint="#FF5757"
        android:textSize="19.5dp"
        android:gravity="center_horizontal|bottom"
        android:paddingBottom="12dp"
        tools:layout_editor_absoluteX="214dp"
        tools:layout_editor_absoluteY="502dp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="71dp"
        android:layout_height="67dp"
        app:srcCompat="@drawable/ss_animals_dog"
        tools:layout_editor_absoluteX="93dp"
        tools:layout_editor_absoluteY="252dp" />


</androidx.constraintlayout.widget.ConstraintLayout>