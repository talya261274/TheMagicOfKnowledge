<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- עיגול עם עיפרון -->
        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardCornerRadius="50dp"
            app:cardElevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✏️"
                android:textSize="48sp" />

        </androidx.cardview.widget.CardView>

        <!-- כותרת -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="✨"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gan"
                android:gravity="center"
                android:shadowColor="#FFD54F"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="עריכת פרופיל"
                android:textColor="#FF9800"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✨"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- שדה שם -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#FF9800"
            app:strokeWidth="2dp">

            <EditText
                android:id="@+id/etEditChildName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/varelaround"
                android:gravity="center"
                android:hint="שם הילד"
                android:inputType="textPersonName"
                android:textColor="#1E5F8B"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- שדה גיל -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#FF9800"
            app:strokeWidth="2dp">

            <EditText
                android:id="@+id/etEditChildAge"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/varelaround"
                android:gravity="center"
                android:hint="גיל (3-8)"
                android:inputType="number"
                android:textColor="#1E5F8B"
                android:textColorHint="#9E9E9E"
                android:textSize="16sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- שגיאה -->
        <TextView
            android:id="@+id/tvEditError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/varelaround"
            android:textColor="#F44336"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- כפתור שמירה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEdit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/gan"
            android:text="שמור שינויים ✓"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="27dp"
            app:elevation="6dp" />

        <!-- כפתור שינוי תמונה -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeAvatar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/varelaround"
            android:text="שנה תמונה 🖼️"
            android:textColor="#1E5F8B"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:strokeColor="#1E5F8B"
            app:strokeWidth="1.5dp" />

        <!-- ביטול -->
        <TextView
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/varelaround"
            android:padding="10dp"
            android:text="ביטול"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>