<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".screens.UserProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="50dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ===== כותרת ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="0dp"
                android:fontFamily="@font/gan"
                android:shadowColor="#65A2B8"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:text="הפרופיל שלי"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- ===== כרטיס פרופיל - שם ותמונה ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:cardBackgroundColor="#c8f4ff"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <FrameLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <androidx.cardview.widget.CardView
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="55dp"
                            app:cardElevation="6dp">

                            <ImageView
                                android:id="@+id/ivParentAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="תמונת פרופיל"
                                android:src="@drawable/logo" />

                        </androidx.cardview.widget.CardView>

                        <!-- כפתור עריכה -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnChangeParentAvatar"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layoutDirection="rtl"
                            android:layout_gravity="top|start"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#928D87"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="8dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="6dp"
                                android:src="@drawable/ic_edit_square"
                                app:tint="#FFFFFF" />

                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                    <!-- שם משתמש -->
                    <TextView
                        android:id="@+id/tv_user_display_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/gan"
                        android:text="שם משתמש"
                        android:textColor="#1E5F8B"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- ID משתמש -->
                    <TextView
                        android:id="@+id/tv_user_display_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/varelaround"
                        android:text="@user123"
                        android:textColor="#9E9E9E"
                        android:textSize="14sp" />

                    <!-- תג מנהל -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/admin_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#FF9800"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gan"
                                android:text="מנהל"
                                android:textColor="#FFFFFF"
                                android:layout_marginEnd="6dp"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👑"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ===== כרטיס פרטים אישיים ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- כותרת + כפתור עריכה באותה שורה -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:layoutDirection="rtl"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/gan"
                            android:text="פרטים אישיים"
                            android:textColor="#1E5F8B"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- כפתור עריכה (אייקון בעיגול) -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/et_update"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="עריכה"
                            android:src="@drawable/ic_edit_square"
                            app:backgroundTint="#FF9800"
                            app:elevation="4dp"
                            app:fabCustomSize="44dp"
                            app:maxImageSize="20dp"
                            app:tint="#FFFFFF" />

                    </LinearLayout>

                    <!-- שם פרטי + שם משפחה -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="שם פרטי"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="#1E5F8B"
                            app:hintTextColor="#1E5F8B">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_user_first_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:fontFamily="@font/varelaround"
                                android:inputType="textPersonName"
                                android:textColor="#2C3E50"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="שם משפחה"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxStrokeColor="#1E5F8B"
                            app:hintTextColor="#1E5F8B">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_user_last_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:fontFamily="@font/varelaround"
                                android:inputType="textPersonName"
                                android:textColor="#2C3E50"
                                android:textSize="15sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- אימייל -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="אימייל"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1E5F8B"
                        app:hintTextColor="#1E5F8B"
                        app:startIconDrawable="@android:drawable/ic_dialog_email"
                        app:startIconTint="#1E5F8B">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:fontFamily="@font/varelaround"
                            android:inputType="textEmailAddress"
                            android:textColor="#2C3E50"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- טלפון -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="מספר טלפון"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1E5F8B"
                        app:hintTextColor="#1E5F8B"
                        app:startIconDrawable="@android:drawable/sym_action_call"
                        app:startIconTint="#1E5F8B">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:fontFamily="@font/varelaround"
                            android:inputType="phone"
                            android:textColor="#2C3E50"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- תאריך לידה -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="תאריך לידה"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1E5F8B"
                        app:hintTextColor="#1E5F8B"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:startIconTint="#1E5F8B">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_birth_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:fontFamily="@font/varelaround"
                            android:inputType="datetime"
                            android:textColor="#2C3E50"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- סיסמה -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="סיסמה"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1E5F8B"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#1E5F8B"
                        app:hintTextColor="#1E5F8B"
                        app:startIconDrawable="@drawable/ic_password"
                        app:startIconTint="#1E5F8B">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_user_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:fontFamily="@font/varelaround"
                            android:inputType="textPassword"
                            android:textColor="#2C3E50"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ===== כרטיס מעקב ילדים ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/childrenTrackingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <!-- כותרת -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/gan"
                        android:text="מעקב ילדים"
                        android:textColor="#1E5F8B"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- ===== קרוסלה אופקית של ילדים ===== -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/container_children_links"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== כפתור התנתקות ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_out"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/gan"
                android:text="התנתקות"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#E91E63"
                app:cornerRadius="28dp"
                app:elevation="6dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="#FFFFFF" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>