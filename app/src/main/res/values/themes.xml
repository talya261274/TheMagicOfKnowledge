<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.TheMagicOfKnowledge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/transparent</item>
        <item name="android:statusBarColor">@color/transparent</item>
    </style>

    <style name="Theme.SplashActivity" parent="Base.Theme.TheMagicOfKnowledge">
        <item name="android:windowSplashScreenAnimatedIcon">@color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="Theme.TheMagicOfKnowledge" parent="Base.Theme.TheMagicOfKnowledge">
        <item name="android:windowBackground">@drawable/main_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NavMenuItemStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gveretlevin</item>
    </style>
</resources>